<!-- KuruKona Showcase Section -->
<template id="section-KurukonaShowcase">
  ##!
    compomint.addI18ns({
      'section-KurukonaShowcase': {
        'title': { 'en': 'Built with Compomint', 'ko': 'Compomint로 만들어진 서비스', 'ja': 'Compomintで構築', 'zh': '使用Compomint构建' },
        'subtitle': { 'en': 'Real-world production platform powered by Compomint', 'ko': '실제 글로벌 프로덕션에서 사용되는 Compomint 기반 올인원 플랫폼', 'ja': 'Compomintで動作するグローバル・プロダクションプラットフォーム', 'zh': '由Compomint驱动的实际全球生产级平台' },
        'appTitle': { 'en': 'KuruKona — All-in-One Event Management Platform', 'ko': 'KuruKona (くるこな) — 올인원 모임·이벤트 관리 플랫폼', 'ja': 'くるこな (KuruKona) — オールインワン・イベント管理プラットフォーム', 'zh': 'KuruKona — 一站式活动与聚会综合管理平台' },
        'appSubtitle': { 'en': 'Smart RSVP, Meeting Polls, Shift Timetables & Bill Splitting', 'ko': '출결 확인·일정 투표·타임테이블 시프트·스마트 N분의1 정산', 'ja': '出欠確認・日程投票・タイムテーブル・スマート割り勘', 'zh': '出勤确认·日程投票·轮班排表·智能差额AA' },
        'appDesc': {
          'en': 'KuruKona is an all-in-one event platform built entirely with Compomint. It features 4 powerful micro-apps (Kurukona, Itsukuru, Itsudare, Pattowari) showcasing fast reactivity, zero-build templates, and seamless 4-language i18n support.',
          'ko': 'KuruKona는 100% Compomint로 프론트엔드가 구축된 올인원 이벤트 플랫폼입니다. 출결/사진공유(Kurukona), 일정투표(Itsukuru), 시프트조정(Itsudare), 스마트정산(Pattowari) 등 4대 핵심 앱을 통해 가볍고 빠른 반응형 웹을 구현했습니다.',
          'ja': 'KuruKonaはCompomintでフロントエンドが完全に構築されたイベント管理プラットフォームです。出欠・写真共有（くるこな）、日程投票（いつくる）、シフト管理（いつだれ）、スマート割り勘（パッと割り）の4大アプリを備えています。',
          'zh': 'KuruKona是完全基于Compomint构建前端的一站式活动平台。包含出勤相册(Kurukona)、日程投票(Itsukuru)、分工时间表(Itsudare)与智能差额分摊(Pattowari)四大核心微应用，展现了极速响应与多语言实力。'
        },
        'builtWithBadge': { 'en': '100% Frontend Powered by Compomint', 'ko': '100% Compomint로 구축된 프론트엔드', 'ja': '100% Compomint製フロントエンド', 'zh': '100% Compomint构建前端' },
        'visitSite': { 'en': 'Visit KuruKona Platform', 'ko': 'KuruKona 웹사이트 방문', 'ja': 'KuruKona Webサイトを訪問', 'zh': '访问KuruKona平台' },
        'app1': { 'en': 'Kurukona: RSVP & Photos', 'ko': 'くるこな: 출결 & 사진공유', 'ja': 'くるこな: 出欠・アルバム', 'zh': 'Kurukona: 出勤与相册' },
        'app2': { 'en': 'Itsukuru: Instant Polls', 'ko': 'いつくる: 로그인 없는 투표', 'ja': 'いつくる: ログイン不要日程投票', 'zh': 'Itsukuru: 免登录日程投票' },
        'app3': { 'en': 'Itsudare: Shifts & Roles', 'ko': 'いつだれ: 타임테이블 시프트', 'ja': 'いつだれ: タイムテーブル・シフト', 'zh': 'Itsudare: 轮班排表分工' },
        'app4': { 'en': 'Pattowari: Smart Splitting', 'ko': 'パッと割り: 스마트 N분의1 정산', 'ja': 'パッと割り: スマート傾斜精算', 'zh': 'Pattowari: 智能AA制精算' }
      }
    });
  ##
  <section id="showcase" class="section-KurukonaShowcase py-12 md:py-16 bg-gradient-to-br from-indigo-50/50 via-white to-purple-50/50 dark:from-gray-900 dark:via-gray-850 dark:to-gray-800">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 md:mb-4 text-gray-900 dark:text-white">##=i18n.title##</h2>
        <p class="text-base sm:text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">##=i18n.subtitle##</p>
      </div>

      <div class="max-w-5xl mx-auto bg-white dark:bg-gray-800 rounded-3xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700 transition-all duration-300 hover:shadow-2xl">
        <div class="flex flex-col lg:flex-row">
          <div class="lg:w-2/5 bg-gradient-to-br from-indigo-600 via-indigo-700 to-purple-700 p-8 sm:p-10 flex flex-col items-center justify-center text-center text-white">
            <img src="img/kurukona-logo.webp" alt="KuruKona Logo" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl shadow-2xl ring-4 ring-white/20 mb-5 object-cover" />
            <h3 class="text-2xl sm:text-3xl font-extrabold mb-1 tracking-tight">KuruKona</h3>
            <p class="text-xs sm:text-sm text-indigo-100/90 font-medium max-w-xs">##=i18n.appSubtitle##</p>
            <div class="mt-5 inline-flex items-center gap-1.5 px-3 py-1 bg-white/15 backdrop-blur-md rounded-full text-xs font-semibold text-white">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Production Active
            </div>
          </div>

          <div class="lg:w-3/5 p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <h4 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-3">##=i18n.appTitle##</h4>
              <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mb-5 leading-relaxed">##=i18n.appDesc##</p>

              <div class="grid grid-cols-2 gap-2 mb-6 text-xs sm:text-sm">
                <div class="p-2.5 rounded-xl bg-indigo-50/70 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 font-medium flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>##=i18n.app1##
                </div>
                <div class="p-2.5 rounded-xl bg-purple-50/70 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 font-medium flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>##=i18n.app2##
                </div>
                <div class="p-2.5 rounded-xl bg-sky-50/70 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 font-medium flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>##=i18n.app3##
                </div>
                <div class="p-2.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 font-medium flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>##=i18n.app4##
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-lg text-xs font-semibold shadow-sm">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7L12 12L22 7L12 2M2 17L12 22L22 17V10L12 15L2 10V17Z"/></svg>
                ##=i18n.builtWithBadge##
              </span>
              <a href="https://kurukona.net" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md hover:shadow-lg transition-all">
                ##=i18n.visitSite##
                <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</template>
